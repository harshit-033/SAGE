# ==============================================================================
# SAGE - Environment Configuration Template
# Production deployments MUST provide cryptographically strong, non-default secrets.
# Insecure fallbacks and synthetic defaults are strictly rejected in production profiles.
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sage_db
POSTGRES_USER=sage_user
POSTGRES_PASSWORD=your_secure_db_password_placeholder

# Java Backend (Spring Boot)
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
# Mandatory in production: Minimum 256-bit (32+ characters) key for HMAC-SHA256 JWT signing.
# Insecure padding or truncation is strictly forbidden by the security provider.
JWT_SECRET=your_minimum_32_characters_secret_key_placeholder_for_jwt_signing
JWT_EXPIRATION_MS=86400000

# Backend <-> Automation Internal Service Authentication
# Shared secret for inter-service authentication (fail closed). Must match between Java and Python.
# Minimum 32 characters required in production profile.
INTERNAL_SERVICE_TOKEN=your_minimum_32_character_internal_service_shared_secret_token
AUTOMATION_SERVICE_URL=http://localhost:8000

# Python Automation Service (FastAPI)
AUTOMATION_PORT=8000
AUTOMATION_HOST=0.0.0.0
BACKEND_SERVICE_URL=http://localhost:8080
ENVIRONMENT=dev

# Frontend (React + Vite)
VITE_API_BASE_URL=http://localhost:8080
VITE_AUTOMATION_BASE_URL=http://localhost:8000
